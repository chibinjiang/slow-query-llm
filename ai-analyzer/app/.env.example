# OpenAI
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://api.chatanywhere.tech/v1
OPENAI_PROMPT_VERSION=v1

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=slow_query_db
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=change_me

# MySQL
ENABLE_MYSQL_EXPLAIN=true
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me

# MongoDB
ENABLE_MONGODB_EXPLAIN=true
MONGODB_URI=mongodb://root:change_me@mongo:27017/?authSource=admin
MONGODB_DATABASES=employees,appdb
MONGODB_PROFILE_SLOWMS=200
MONGODB_WATERMARK_FILE=mongo_profile_watermark.json
